<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Same policy for cloud backup and device-to-device transfer: rules only. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="rules.json" />
        <include domain="file" path="alarms.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="rules.json" />
        <include domain="file" path="alarms.json" />
    </device-transfer>
</data-extraction-rules>
